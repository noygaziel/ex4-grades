/* ===== חלון ראשי ===== */
QWidget#central {
    background-color: #f4f6fb;
    font-family: "Segoe UI";
    font-size: 13px;
    color: #1e293b;
}
QLabel#title { font-size: 24px; font-weight: 700; color: #0f172a; }
QLabel#file_label {
    background-color: #ffffff;
    border: 1px solid #d5dbe6;
    border-radius: 6px;
    padding: 6px 10px;
    color: #64748b;
}

/* ===== כפתורים (BONUS: אפקט hover / לחיצה) ===== */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 16px;
}
QPushButton:hover    { background-color: #e2e8f0; }
QPushButton:pressed  { background-color: #cbd5e1; padding-top: 9px; }
QPushButton:disabled { color: #a0aec0; background-color: #f1f5f9; }

QPushButton#btn_primary {
    background-color: #2563eb; color: white; border: none; font-weight: 600;
}
QPushButton#btn_primary:hover   { background-color: #1d4ed8; }
QPushButton#btn_primary:pressed { background-color: #1e40af; }

/* ===== טבלה ===== */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #d5dbe6;
    border-radius: 6px;
    gridline-color: #e2e8f0;
    selection-background-color: #bfdbfe;
    selection-color: #0f172a;
}
QHeaderView::section {
    background-color: #e2e8f0; font-weight: 600; padding: 6px; border: none;
}
QSpinBox {
    background-color: #ffffff; border: 1px solid #cbd5e1;
    border-radius: 6px; min-width: 70px;
}